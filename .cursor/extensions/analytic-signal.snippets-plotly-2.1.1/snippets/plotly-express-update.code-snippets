    "margin": {
        "prefix": "px-update-margin",
        "description": "Update layout margins",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\tmargin={",
            "\t\t't':${2:30},",
            "\t\t'b':${3:10},",
            "\t\t'l':${4:10},",
            "\t\t'r':${5:10}",
            "\t}",
            ")",
            "$0"
        ]
    },
    "rangeslider": {
        "prefix": "px-update-rangeslider",
        "description": "Add a rangeslider to the x-axis layout",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\txaxis_rangeslider_visible=${2|True,False|},",
            "\tyaxis_fixedrange=${3|False,True|}",
            ")",
            "$0"
        ]
    },
	"rangeselector": {
        "prefix": "px-update-rangeselector",
        "description": "Add rangeselector buttons to the x-axis layout",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\txaxis_rangeselector=dict(",
            "\t\tbuttons=[",
            "\t\t\tdict(",
            "\t\t\t\tcount=${2:1},",
            "\t\t\t\tstep=\"${3|month,year,day,hour,minute,second,all|}\",",
            "\t\t\t\tlabel=\"${2} $3\",",
            "\t\t\t\tstepmode=\"${4|backward,todate|}\",",
            "\t\t\t),",
            "\t\t\tdict(",
            "\t\t\t\tstep=\"all\"",
            "\t\t\t)",
            "\t\t]",
            "\t)",
            ")",
            "$0"
        ]
    },
    "scaleratio": {
        "prefix": "px-update-scaleratio",
        "description": "Fix scale ratio between x and y axes at 1:1",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\tyaxis_scaleanchor='x',",
            "\tyaxis_scaleratio=${2:1}",
            ")",
            "$0"  
        ]
    },
    "autorange": {
        "prefix": "px-update-autorange",
        "description": "Axis autorange",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_${2|xaxes,yaxes|}(",
            "\tautorange=${3|True,False,'reversed'|}",
            ")",
            "$0"
        ]
    },
    "scene aspect ratio": {
        "prefix": "px-update-scene-aspectratio",
        "description": "Manually fix the aspect ratio between x, y, and z axes in a 3d scene",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\tscene_aspectratio = dict(",
            "\t\tx=${2:1},", 
            "\t\ty=${3:1},",
            "\t\tz=${4:1}", 
            "\t)",
            ")",
            "$0"  
        ]
    },
    "scene aspect mode": {
        "prefix": "px-update-scene-aspectmode",
        "description": "Set the aspect mode of a 3d scene",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_layout(",
            "\tscene_aspectmode='${2|auto,cube,data,manual|}'",
            ")",
            "$0"  
        ]
    },
    "scattermatrix parts": {
        "prefix": "px-update-scattermatrix-parts",
        "description": "Update visibility of scattermatrix diagonal, lowerhalf, and upperhalf parts",
        "body": [
            "${1:$TM_SELECTED_TEXT}.update_traces(",
            "\tdiagonal_visible=${2|True,False|},",
            "\tshowlowerhalf=${3|True,False|},",
            "\tshowupperhalf=${4|True,False|},",
            ")",
            "$0"  
        ]
    },
